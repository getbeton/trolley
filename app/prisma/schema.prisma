generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Authenticated admin using the migration UI.
model User {
  id               String            @id @default(uuid())
  email            String?           @unique
  displayName      String?
  organization     String?
  credentials      Credential[]
  migrations       Migration[]
  entitySelections EntitySelection[]
  fieldSelections  FieldSelection[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

/// Stores user-provided secrets (Twenty base URL/token, Attio token, etc.).
model Credential {
  id                String           @id @default(cuid())
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  type              CredentialType
  label             String?
  secret            String
  status            CredentialStatus @default(PENDING)
  lastValidatedAt   DateTime?
  validationMessage String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([userId, type], map: "unique_credential_per_user_type")
  @@index([userId, type], name: "idx_credentials_user_type")
}

/// Tracks which CRM entities the user opted into for a migration.
model EntitySelection {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  migrationId         String?
  migration           Migration?       @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  system              CrmSystem
  entityName          String
  entityLabel         String?
  status              SelectionStatus  @default(PENDING)
  includeInSync       Boolean          @default(false)
  availableFieldCount Int?
  sampleRecord        Json?
  metadata            Json?
  fields              FieldSelection[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([userId, system, entityName], map: "unique_entity_per_user_system")
  @@index([migrationId, system], name: "idx_entity_selection_migration_system")
}

/// Individual fields (columns) pulled from a selected entity.
model FieldSelection {
  id                String          @id @default(cuid())
  entitySelectionId String
  entitySelection   EntitySelection @relation(fields: [entitySelectionId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldName         String
  fieldLabel        String?
  fieldType         String?
  isRequired        Boolean         @default(false)
  isSelected        Boolean         @default(false)
  sampleValue       Json?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  sourceMappings FieldMapping[] @relation("SourceFieldMappings")
  targetMappings FieldMapping[] @relation("TargetFieldMappings")

  @@index([entitySelectionId, fieldName], name: "idx_field_selection_entity_field")
  @@unique([entitySelectionId, fieldName], map: "entity_field_unique")
}

/// High-level migration configuration users review before executing.
model Migration {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         MigrationStatus @default(DRAFT)
  sourceSystem   CrmSystem       @default(TWENTY)
  targetSystem   CrmSystem       @default(ATTIO)
  config         Json?
  recordEstimate Int?
  etaSeconds     Int?
  lastRunAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  entitySelections EntitySelection[]
  runs             MigrationRun[]
  fieldMappings    FieldMapping[]

  @@index([userId, status], name: "idx_migration_user_status")
  @@unique([userId, name], map: "unique_migration_name_per_user")
}

/// Each execution attempt as we move records between CRMs.
model MigrationRun {
  id                String                @id @default(cuid())
  migrationId       String
  migration         Migration             @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  status            RunStatus             @default(QUEUED)
  progress          Float?
  etaSeconds        Int?
  recordsProcessed  Int?
  batchesProcessed  Int?
  rateLimitHitCount Int?
  errorMessage      String?
  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  metrics           Json?
  logs              MigrationLog[]
  notifications     WebhookNotification[]

  @@index([migrationId, status], name: "idx_run_migration_status")
}

/// Streaming log records for observability and diagnostics.
model MigrationLog {
  id              String       @id @default(cuid())
  runId           String
  run             MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  level           LogLevel     @default(INFO)
  message         String
  context         Json?
  entityReference String?
  createdAt       DateTime     @default(now())

  @@index([runId, level], name: "idx_log_run_level")
}

/// Explicit mapping between a source field and a destination field.
model FieldMapping {
  id             String         @id @default(cuid())
  migrationId    String
  migration      Migration      @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  sourceFieldId  String
  sourceField    FieldSelection @relation("SourceFieldMappings", fields: [sourceFieldId], references: [id], onDelete: Cascade)
  targetFieldId  String
  targetField    FieldSelection @relation("TargetFieldMappings", fields: [targetFieldId], references: [id], onDelete: Cascade)
  transformation Json?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([migrationId, sourceFieldId, targetFieldId], map: "unique_field_mapping_triplet")
}

/// Outbound webhook delivery attempts for user notifications.
model WebhookNotification {
  id                 String        @id @default(cuid())
  runId              String
  run                MigrationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  event              WebhookEvent
  status             WebhookStatus @default(PENDING)
  targetUrl          String
  payload            Json?
  responseStatusCode Int?
  responseBody       String?
  attemptCount       Int           @default(0)
  lastAttemptAt      DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([runId, status], name: "idx_webhook_run_status")
}

/// Supported credential buckets we need to validate/store.
enum CredentialType {
  TWENTY_BASE_URL
  TWENTY_API_TOKEN
  TOOL_TOKEN
  ATTIO_API_TOKEN
  NOTIFICATION_WEBHOOK
}

/// State machine for async credential validation.
enum CredentialStatus {
  PENDING
  VALID
  INVALID
  ERROR
}

/// CRM backends we understand today.
enum CrmSystem {
  TWENTY
  ATTIO
  INTERNAL
}

/// Selection lifecycle as users preview and confirm schemas.
enum SelectionStatus {
  PENDING
  FETCHING
  READY
  ERROR
}

/// High-level migration status per user configuration.
enum MigrationStatus {
  DRAFT
  COLLECTING
  VALIDATING
  READY
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Execution lifecycle per migration run.
enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Server-side log severity stored per run.
enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// Delivery lifecycle for webhook notifications.
enum WebhookStatus {
  PENDING
  RETRYING
  DELIVERED
  FAILED
}

/// Events that may trigger webhook fan-out.
enum WebhookEvent {
  MIGRATION_COMPLETED
  MIGRATION_FAILED
  RUN_PROGRESS
}
